      "id": "resolve-python311-env",
      "title": "Resolve server run issue (install Python 3.11, venv setup, start servers)",
      "status": "TODO",
      "created_at": "2025-08-17T22:54:48Z",
      "details": {
        "steps": [
          "Install Python 3.11 (winget install -e --id Python.Python.3.11)",
          "Create venv: py -3.11 -m venv .venv311",
          "Activate: . .venv311/Scripts/Activate.ps1",
          "Install deps: pip install -r pipelines/categorize_and_relate/server/requirements.txt",
          "Run backend: uvicorn pipelines.categorize_and_relate.server.main:app --reload --port 8000",
          "Serve UI: python -m http.server 5173 --directory pipelines/categorize_and_relate/web"
        ],
        "prereqs": [
          "ffmpeg on PATH",
          "Ollama running with model pulled (gemma3:4b by default)"
        ]
      }
    }
  ]
}
